# EventDesk.ro environment. Names only — every value is an operator decision
# (docs/build/10-operator-decisions.md). Copy to .env for local development.
# Never commit real values (SEC13).

NODE_ENV=development

# --- Core (required at boot) ---
DATABASE_URL=postgresql://ed:ed@127.0.0.1:5432/eventdesk_dev
APP_URL=http://localhost:3000
PUBLIC_URL=http://localhost:3001
MEDIA_URL=http://localhost:3002
# >= 32 characters, random
SESSION_SECRET=

# --- Optional / defaults ---
APP_VERSION=
LOG_LEVEL=info
# Admin connection used only by the test harness to create/drop databases
TEST_DATABASE_ADMIN_URL=postgresql://ed:ed@127.0.0.1:5432/postgres

# --- Email (INF2; provider is operator-configurable) ---
EMAIL_PROVIDER=dev
EMAIL_FROM=
EMAIL_PROVIDER_API_KEY=
EMAIL_WEBHOOK_SECRET=

# --- Object store (INF3; S3-compatible, EU) ---
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PRIVATE=
S3_BUCKET_MEDIA=

# --- Malware scanner (SEC4; operator-configurable) ---
MALWARE_SCANNER=none
MALWARE_SCANNER_URL=

# --- AI text (INF7; operator-configurable) ---
AI_TEXT_PROVIDER=none
AI_TEXT_MODEL=
AI_TEXT_API_KEY=

# --- Payments / invoicing (dormant until MON ON) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
INVOICING_PROVIDER=none
INVOICING_API_KEY=

# --- Deploy console (DEP1) ---
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPO=

# --- MCP ---
MCP_SIGNING_SECRET=

# --- Backups (INF10 / SEC9) ---
BACKUP_ENCRYPTION_KEY_ID=
