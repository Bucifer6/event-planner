# EventDesk.ro — every environment variable the code reads. NAMES ONLY.
#
# Local development: copy this file to .env (it is git-ignored) and fill in the few values
# marked [dev]. Staging and production do NOT use a file in the repository: the values live
# in the platform secret store and are injected at start (SEC13). Never commit a real value.
#
# Marks:  [required]  the app refuses to boot without it
#         [dev]       set this for local development
#         [operator]  an open operator decision — docs/build/10-operator-decisions.md
#         [secret]    keep it in the secret store; rotate yearly and when staff leave
# Unmarked variables are optional and have a sensible default.

# ── Core ─────────────────────────────────────────────────────────────────────
# development | test | production
NODE_ENV=development
# [required][secret] PostgreSQL 16 connection string of the application role
DATABASE_URL=postgresql://ed:ed@127.0.0.1:5432/eventdesk_dev
# [required] Public origin of the web app (app.<domain>). https in production
# While this is a localhost address AND no legal documents have been recorded in the console,
# new accounts can be created (local first run). On any other address sign-up stays closed
# until terms, privacy policy and cookie notice are recorded as published (LAU1).
APP_URL=http://localhost:3000
# [required] Public origin of the public site (<domain>)
PUBLIC_URL=http://localhost:3001
# [optional] Support address shown on the help centre (/help → "Contact and reporting").
# Leave empty to show no address; the report form, status page and legal links are always shown.
SUPPORT_EMAIL=
# [required] Origin that serves uploaded PDFs (media.<domain>); must differ from APP_URL in production (SEC4)
MEDIA_URL=http://localhost:3002
# [required][secret][dev] At least 32 random characters; signs sessions and scoped links
SESSION_SECRET=
# Release tag shown by /api/health and checked by the deploy pipeline (set by the image)
APP_VERSION=
# debug | info | warn | error
LOG_LEVEL=info
# Request header that carries the client address behind the ingress (default x-forwarded-for) [operator]
TRUSTED_IP_HEADER=
# x-forwarded-for only: how many of OUR proxies sit in front of the app (default 1). The client
# address is read that many entries from the right; entries a client sends itself are ignored [operator]
TRUSTED_PROXY_HOPS=
# Minimum duration of sign-in answers in ms (timing equalisation); 0 only in tests
AUTH_TIMING_FLOOR_MS=

# ── Public site (apps/public, read at BUILD time) ────────────────────────────
# Where "Open the app" links point (the APP_URL of the same environment)
NEXT_PUBLIC_APP_URL=
# Canonical origin of the public site (hreflang, sitemap)
NEXT_PUBLIC_SITE_URL=

# ── Email (INF2, LAU3) ───────────────────────────────────────────────────────
# dev = nothing is sent, the message is kept in the email_outbox table; http = generic provider seam [operator]
EMAIL_PROVIDER=dev
# Sender, e.g. "EventDesk <no-reply@eventdesk.ro>" (domain needs SPF, DKIM, DMARC) [operator]
EMAIL_FROM=
# Endpoint of the transactional email provider (EU delivery) [operator]
EMAIL_PROVIDER_URL=
# [secret] API key of the email provider
EMAIL_PROVIDER_API_KEY=
# [secret] Shared secret of the bounce/complaint webhook (/api/webhooks/email)
EMAIL_WEBHOOK_SECRET=

# ── Object storage (INF3; S3-compatible, EU) ─────────────────────────────────
# Local folder for uploads when no bucket is configured (development, single-host installs)
STORAGE_DIR=
# S3-compatible endpoint; local MinIO from docker-compose.dev.yml is http://127.0.0.1:9000 [operator]
S3_ENDPOINT=
# Region of the buckets (EU) [operator]
S3_REGION=
# [secret] Access key (omit both when the host's own role grants access)
S3_ACCESS_KEY_ID=
# [secret] Secret key
S3_SECRET_ACCESS_KEY=
# Private bucket: every upload, read through signed scoped links only
S3_BUCKET_PRIVATE=
# Media bucket: PDFs served from MEDIA_URL as downloads (SEC4)
S3_BUCKET_MEDIA=
# true | false — path-style addressing (default: true when S3_ENDPOINT is set)
S3_FORCE_PATH_STYLE=
# Customer-managed key for server-side encryption of stored objects (INF12)
S3_SSE_KMS_KEY_ID=
# [secret] Signs scoped file links (default: SESSION_SECRET)
STORAGE_URL_SECRET=

# ── Upload scanning and PDF tooling (SEC4) ───────────────────────────────────
# none | command | http — a file becomes visible only after a clean scan; production refuses "none" [operator]
MALWARE_SCANNER=none
# Command run with the file path appended (MALWARE_SCANNER=command)
MALWARE_SCANNER_COMMAND=
# Scanner endpoint (MALWARE_SCANNER=http)
MALWARE_SCANNER_URL=
# Binary that renders PDF pages to images (default: pdftoppm from poppler)
PDF_RASTERISER_BIN=
# Folder with the DejaVu .ttf files for generated PDFs (set by the web image)
PDF_FONT_DIR=

# ── Worker (apps/worker) ─────────────────────────────────────────────────────
# Jobs run in parallel (default 4)
WORKER_CONCURRENCY=
# Idle wait between queue passes in ms (default 2000)
WORKER_POLL_MS=
# Alert when more jobs than this are waiting (default 500)
ALERT_QUEUE_DEPTH=
# Alert when the share of failed jobs in the last hour exceeds this (default 0.2)
ALERT_ERROR_RATE=
# Alert when the oldest due job has waited longer than this, in seconds (default 900)
ALERT_OLDEST_DUE_SECONDS=
# [secret] Webhook of the monitored operator channel for those alerts (LAU5) [operator]
OPS_ALERT_WEBHOOK_URL=

# ── Backups (INF10, SEC9) ────────────────────────────────────────────────────
# Command of the daily backup job, e.g. "bash /app/scripts/deploy/container-backup.sh daily" [operator]
BACKUP_COMMAND=
# Command of the monthly restore test, e.g. "bash /app/scripts/deploy/container-restore-test.sh" [operator]
RESTORE_TEST_COMMAND=
# Time limit for either command in ms (default 2 hours)
BACKUP_COMMAND_TIMEOUT_MS=
# PUBLIC age key the dumps are encrypted with; the private key is held elsewhere, never with the backups [operator]
BACKUP_AGE_RECIPIENT=
# Backup bucket (separate from the asset buckets)
BACKUP_S3_BUCKET=
# S3-compatible endpoint of the backup bucket (EU)
BACKUP_S3_ENDPOINT=
# Region of the backup bucket
BACKUP_S3_REGION=
# [secret] Access key for the backup bucket (omit both when the host's own role grants access)
BACKUP_S3_ACCESS_KEY_ID=
# [secret] Secret key for the backup bucket
BACKUP_S3_SECRET_ACCESS_KEY=
# At-rest key of the backup bucket — a different key from S3_SSE_KMS_KEY_ID
BACKUP_S3_SSE_KMS_KEY_ID=
# [secret] Path of the PRIVATE age key, mounted only for a restore test (never stored on the backup host)
BACKUP_AGE_IDENTITY_FILE=
# [secret] Empty scratch database the restore test restores into (never the production database)
RESTORE_TEST_DATABASE_URL=

# ── Deployments from the console (DEP1–DEP7) ─────────────────────────────────
# Id of the GitHub App installed on the ONE private, organisation-owned repository [operator]
GITHUB_APP_ID=
# [secret] The App's private key (PEM; newlines may be written as \n). Server-side only, never sent to a browser
GITHUB_APP_PRIVATE_KEY=
# Installation id of the App on that repository
GITHUB_APP_INSTALLATION_ID=
# The repository as "owner/name"
GITHUB_REPO=
# Branch the deploy workflow file is read from (default main)
GITHUB_DEFAULT_BRANCH=
# File name of the deploy workflow (default deploy.yml)
GITHUB_DEPLOY_WORKFLOW=
# API base for GitHub Enterprise Server (default https://api.github.com)
GITHUB_API_URL=
# Commit-status context that marks a release as CI-green (default release-ci)
DEPLOY_CI_CONTEXT=
# [secret] Machine token the deploy pipeline presents to /api/deploys/record; 32+ random characters.
# The same value is the GitHub environment secret DEPLOY_RECORD_TOKEN
DEPLOY_RECORD_TOKEN=

# ── MCP endpoint (APP_URL/mcp) ───────────────────────────────────────────────
# Calls one token may make per minute (default 60)
MCP_CALLS_PER_MINUTE=
# Calls one token may make per day (default 2000)
MCP_CALLS_PER_DAY=
# Failed authentications allowed per address per hour (default 60)
MCP_AUTH_FAILURES_PER_IP_PER_HOUR=

# ── Payments and invoicing (dormant until monetization is switched on) ───────
# [secret] Stripe secret key (PAY5: Stripe first, Netopia fallback) [operator]
STRIPE_SECRET_KEY=
# [secret] Stripe webhook signing secret
STRIPE_WEBHOOK_SECRET=
# Stripe payment-method configuration id
STRIPE_PAYMENT_METHOD_CONFIGURATION=
# Registered fiscal invoicing connector (SmartBill / Oblio / equivalent) [operator]
INVOICING_PROVIDER=
# [secret] Shared secret of the invoicing webhook; unset = the endpoint answers 404
INVOICING_WEBHOOK_SECRET=

# ── Tests and tooling (never in production) ──────────────────────────────────
# Admin connection the test harness uses to create and drop its own databases
TEST_DATABASE_ADMIN_URL=postgresql://ed:ed@127.0.0.1:5432/postgres
# standalone = container build of the web app (set by the Dockerfile only)
NEXT_OUTPUT=

# ── AI wording suggestions (INF7; read by packages/core/src/aitext.ts) ───────
# Optional. Left unset the feature is off and no text ever leaves the server.
# AI_TEXT_PROVIDER   off (default) | dev (fixed templates, no vendor) | http (generic seam) [operator]
# AI_TEXT_MODEL      free text recorded with every result [operator]
# AI_TEXT_URL        endpoint of the "http" provider: receives a JSON POST, answers { "text": "…" } [operator]
# AI_TEXT_API_KEY    [secret] sent as "Authorization: Bearer …" to AI_TEXT_URL

# ── Fonts for generated stationery PDFs (read by packages/core/src/stationerykit.ts) ──
# Optional. Folder holding the @expo-google-fonts packages (bodoni-moda, hanken-grotesk).
# Without it the code looks in node_modules and falls back to the DejaVu fonts (PDF_FONT_DIR).
# STATIONERY_FONT_DIR

# ── Read by scripts/record-deploy.mjs inside the deploy workflow only ────────
# (GitHub "production" environment; listed here so no name is undocumented)
# DEPLOY_RECORD_URL   APP_URL + /api/deploys/record
# DEPLOY_ID           the console's id for the deploy (workflow input)
# DEPLOY_TAG          the release tag being deployed
# DEPLOY_COMMIT       the commit the tag points at
# DEPLOY_TARGET       which implementation scripts/deploy/*.sh use (reference: ssh-docker) [operator]
# IMAGE_PREFIX, REGISTRY, REGISTRY_USERNAME, REGISTRY_PASSWORD   container registry [operator]
# DEPLOY_SSH_HOST, DEPLOY_SSH_USER, DEPLOY_SSH_PORT, DEPLOY_DIR, DEPLOY_SSH_KEY, DEPLOY_SSH_KNOWN_HOSTS   (ssh-docker target)
