# Copy to .env for local development. Never commit real secrets (SEC13).
# In production these come from the platform secret store, never from the repo.

# PostgreSQL (dev: started by `pnpm db:up` into .pgdata/)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventdesk"

# App URLs (INF1). Local dev uses localhost; production: eventdesk.ro / app.eventdesk.ro / media.eventdesk.ro
APP_URL="http://localhost:3000"
PUBLIC_URL="http://localhost:3001"
MEDIA_URL="http://localhost:3002"

# Transactional email provider (INF2, operator-configurable, EU delivery preferred).
# dev = writes to the EmailOutbox table + console; no external provider is called.
EMAIL_PROVIDER="dev"
EMAIL_FROM="EventDesk <noreply@eventdesk.ro>"

# S3-compatible object store (INF3, operator-configurable, EU region)
S3_ENDPOINT=""
S3_REGION="eu-central-1"
S3_BUCKET_PRIVATE="eventdesk-private"
S3_BUCKET_MEDIA="eventdesk-media"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Session cookie
SESSION_COOKIE="ed_session"
NODE_ENV="development"
