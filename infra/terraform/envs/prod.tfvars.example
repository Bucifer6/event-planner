# Copy to prod.tfvars (never commit) and fill operator-owned values.
env                       = "prod"
region                    = "eu-central-1" # EU region for the chosen vendor (INF9)
root_domain               = "eventdesk.ro"
app_domain                = "app.eventdesk.ro"
media_domain              = "media.eventdesk.ro"
database_url_secret_arn   = "arn:...:secret:eventdesk/prod/database-url"
app_secrets_arn           = "arn:...:secret:eventdesk/prod/app-secrets"
backup_kms_key_arn        = "arn:...:kms:..." # managed separately from backups (SEC9)
db_instance_class         = "db.t4g.medium" # sized by operator
app_image                 = "ghcr.io/<org>/event-planner/web:<tag-from-deploy-workflow>"
