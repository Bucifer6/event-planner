# Copy to production.tfvars (never commit it) and replace every PLACEHOLDER.
#   terraform plan -var-file=production.tfvars

environment = "production"
domain      = "eventdesk.ro"

# OPERATOR DECISION (INF9): an EU region; Romania preferred where the vendor has one.
region = "eu-central-1"

# Empty zone id = create the zone, then set the registrar's name servers to the output.
manage_dns  = true
dns_zone_id = ""

# From the email provider (INF2, LAU3). Production must not go live without them.
email_spf   = ""
email_dkim  = {}
email_dmarc = ""

# PLACEHOLDER sizes. Multi-AZ is an operator decision (cost against the 4 h RTO).
db_instance_class       = "db.t4g.small"
db_allocated_storage_gb = 20
db_multi_az             = false
host_instance_type      = "t3.medium"

# PLACEHOLDER: the public half of the GitHub environment secret DEPLOY_SSH_KEY.
deploy_ssh_public_key = ""

# OPERATOR DECISION: who may reach SSH on the host (see variables.tf). Empty = closed.
deploy_ssh_cidrs = []

# PLACEHOLDER contacts: TLS certificates, and the monitored alert mailbox (LAU5).
acme_email  = "ops@example.invalid"
alert_email = "alerts@example.invalid"
