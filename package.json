{
  "name": "eventdesk-ro",
  "private": true,
  "version": "0.0.0",
  "description": "EventDesk.ro — event planning platform (PRD v4.9, Romania edition). See docs/PRD.md and docs/build/.",
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "dev": "pnpm --filter @eventdesk/web dev",
    "dev:worker": "pnpm --filter @eventdesk/worker dev",
    "dev:public": "pnpm --filter @eventdesk/public-site dev",
    "db:up": "node scripts/db-up.mjs",
    "db:studio": "pnpm --filter @eventdesk/db exec prisma studio",
    "migrate:dev": "pnpm --filter @eventdesk/db exec prisma migrate dev",
    "migrate:deploy": "pnpm --filter @eventdesk/db exec prisma migrate deploy",
    "db:seed": "pnpm --filter @eventdesk/db exec prisma db seed",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @eventdesk/core test:integration",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "pnpm --filter @eventdesk/db exec prisma generate"
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "prettier": "3.10.1",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/linux-x64",
      "argon2"
    ],
    "overrides": {
      "postcss": "^8.5.32",
      "deepmerge-ts": "^8.0.2"
    }
  }
}
