// EventDesk.ro data model — see docs/build/02-data-model.md (PRD v4.9).
// Conventions: cuid2 ids (never sequential, SEC2); invitation/guest-link tokens >=128-bit,
// stored hashed (SEC8); timestamps stored in UTC (INF8); money in integer minor units (bani);
// unknown values are NULL and render as "unknown", never 0 (principle 5);
// AuditLog is append-only, enforced by a DB trigger (SEC10).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountKind {
  email
  anonymous
}

enum Role {
  owner
  project_manager
  workstream_lead
  contributor
  supplier
  guest
}

enum TaskStatus {
  todo
  in_progress
  blocked
  done
}

enum DelegationState {
  offered
  accepted
  declined
}

enum PollChoice {
  yes
  maybe
  no
}

enum PreviewState {
  pending
  applied
  discarded
}

enum InvitationExpiryMode {
  never
  rsvp_deadline
  closeout
}

enum ClaimState {
  claimed
  released
}

enum RsvpQuestionKind {
  menu_choice
  allergies
  accommodation_need
  transport_need
  free_text
}

enum DateMode {
  date
  range
  poll
}

enum OccasionStatus {
  active
  archived
  closed
  cancelled
  postponed
}

model Account {
  id              String      @id @default(cuid())
  kind            AccountKind @default(email)
  email           String?     @unique
  username        String?     @unique
  passwordHash    String? // Argon2id, per-account salt (S8); null for email accounts
  locale          String      @default("ro")
  hideDirectoryLinks Boolean  @default(false) // P7: per-account switch for the task directory link
  emailVerifiedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sessions      Session[]
  recoveryCodes RecoveryCode[]
  totpSecret    TotpSecret?
  mcpTokens     McpToken[]
  staffMember   StaffMember?
  occasions     Occasion[]
  business      Business?
}

model Session {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deviceType String?
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime // 30 days, or 14 days idle (S3)
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

// Sign-in codes: identifier is an email (email accounts) or username (anonymous).
// Only hashes are stored (SEC8). Codes expire after 15 min, max 5 attempts (INF4),
// single-use, and a newer code invalidates older ones (SEC1).
model SignInCode {
  id             String    @id @default(cuid())
  accountId      String?
  identifierHash String // sha256 of normalized email or username
  codeHash       String
  attempts       Int       @default(0)
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime  @default(now())

  magicLinks MagicLink[]

  @@index([identifierHash])
}

model MagicLink {
  id         String      @id @default(cuid())
  tokenHash  String      @unique
  codeId     String
  code       SignInCode  @relation(fields: [codeId], references: [id], onDelete: Cascade)
  identifier String // the address the code was requested for (codes/tokens stay hashed, SEC8)
  usedAt     DateTime?
  expiresAt  DateTime // expires together with its code (SEC14)
  createdAt  DateTime    @default(now())
}

model RecoveryCode {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
}

model TotpSecret {
  id          String    @id @default(cuid())
  accountId   String    @unique
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  secret      String
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
}

model McpToken {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  scopes     String[] // read | read_propose (MCP1)
  lastUsedAt DateTime?
  revokedAt  DateTime?
  consentShownAt DateTime? // MCP4: per-token consent warning shown before first use
  createdAt  DateTime  @default(now())

  callLogs McpCallLog[]

  @@index([accountId])
}

// SEC16/SEC11 rate-limit buckets, one row per (axis, key, window).
model RateLimitBucket {
  id           String    @id @default(cuid())
  axis         String // email | ip | device
  key          String
  windowStart  DateTime
  count        Int       @default(0)
  level        Int       @default(0) // escalating backoff level, per address only, never a lockout
  penaltyUntil DateTime?
  expiresAt    DateTime

  @@unique([axis, key, windowStart])
  @@index([expiresAt])
}

// Security log: never records whether an account exists (SEC16).
model SecurityLog {
  id       String   @id @default(cuid())
  event    String
  axisKey  String?
  at       DateTime @default(now())
  meta     Json?

  @@index([at])
}

// Append-only audit log (SEC10): a DB trigger blocks UPDATE/DELETE for every role.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorKind  String // account | staff | system | mcp_token
  action     String
  objectType String
  objectId   String?
  before     Json?
  after      Json?
  at         DateTime @default(now())

  @@index([at])
  @@index([objectType, objectId])
}

model DeletionRequest {
  id           String    @id @default(cuid())
  targetType   String // account | occasion
  targetId     String
  requestedAt  DateTime  @default(now())
  undoUntil    DateTime // +7 days (D6)
  completedAt  DateTime?
  retainedNote String?

  @@unique([targetType, targetId])
}

// Six staff roles (PRD section 10): platform_admin, content_editor, listing_moderator,
// commercial_manager, privacy_owner, security_administrator.
model StaffMember {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  roles     String[]
  createdAt DateTime @default(now())

  sessions StaffSession[]
}

// Second-person approval queue (W9): queued actions have no effect until approved.
model ApprovalRequest {
  id          String    @id @default(cuid())
  action      String
  payload     Json
  requesterId String
  approverId  String?
  state       String    @default("pending") // pending | approved | rejected
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([state])
}

model Occasion {
  id               String        @id @default(cuid())
  ownerId          String
  owner            Account       @relation(fields: [ownerId], references: [id])
  businessId       String? // P17: business-owned occasions
  business         Business?     @relation(fields: [businessId], references: [id])
  handedOverAt     DateTime? // P22: handover to the client ends business-side access
  handedOverToId   String?
  handoverById     String?
  publicSlug       String?   @unique // C-06: public event page slug
  publicPageOn     Boolean   @default(false) // C-06: registration open
  publicQuestions  Json? // C-06: conditional registration questions
  programmeRevision Int      @default(0) // C-10: bumped per programme change; guests notified once per bump
  lastProgrammeNoticeRevision Int @default(0) // C-10: guests already notified up to this revision
  venueAddress     String? // C-10: guest event page address
  venueMapsUrl     String? // C-10: external navigation link (opens guest's maps app, SEC7)
  title            String
  kind             String // template kind: picnic | aniversare | nunta | botez | revelion | voiaj_solo | voiaj_grup | custom
  dateMode         DateMode      @default(date)
  dateStart        DateTime?
  dateEnd          DateTime?
  status           OccasionStatus @default(active)
  capacityTotal    Int? // one capacity count shared by invited and public guests (A8)
  seatsTaken       Int           @default(0)
  briefPurpose     String?
  briefPriorities  Json? // up to 3 priorities (A11)
  revision         Int           @default(0) // bumped on every change; powers "changed since your last visit" (INF5)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  members        OccasionMember[]
  tasks          Task[]
  households     Household[]
  invitations    Invitation[]
  rsvpQuestions  RsvpQuestion[]
  polls          DatePoll[]
  needs          ContributionNeed[]
  previews       WhatIfPreview[]
  digests        ReminderDigest[]
  categories     BudgetCategory[]
  expenses       Expense[]
  seatingPlans   SeatingPlan[]
  mealStages     MealStage[]
  programme      ProgrammeItem[]
  invitationDesigns InvitationDesign[]
  menus          Menu[]
  publicRegistrations PublicRegistration[]
  arrangementDesigns ArrangementDesign[]
  itineraryLegs   ItineraryLeg[]
  subgroups       Subgroup[]
  activities      Activity[]
  packingItems    PackingItem[]
  transportLegs   TransportLeg[]
  rooms           Room[]
  ledgerEntries  LedgerEntry[]
  suppliers      Supplier[]
  bookings       Booking[]
  deliveries     Delivery[]
  readiness      ReadinessDecision[]
  closeout       Closeout?
  spaceModels    SpaceModelVersion[]
  checkIns       CheckIn[]
  offlineSyncItems OfflineSyncItem[]
  sustainabilityGoals SustainabilityGoal[]

  @@index([ownerId])
}

model OccasionMember {
  id                String   @id @default(cuid())
  occasionId        String
  occasion          Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  accountId         String?
  inviteEmail       String? // pending invite before the account exists
  role              Role
  customLabel       String? // localized role labels, e.g. naș/nasă, domn/damnă de cununie (A5)
  finance           Boolean  @default(false) // separate grant (A5, D2)
  privateRequests   Boolean  @default(false) // separate grant (A5, D2)
  hideDirectoryLinks Boolean @default(false) // P7: per-occasion switch
  createdAt         DateTime @default(now())

  ownedTasks Task[]

  @@unique([occasionId, accountId])
  @@index([occasionId])
}

model Template {
  id        String         @id @default(cuid())
  kind      String         @unique
  nameKey   String // i18n key for the localized name (L1)
  tasks     TemplateTask[]
  createdAt DateTime       @default(now())
}

model TemplateTask {
  id           String    @id @default(cuid())
  templateId   String
  template     Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  titleKey     String // i18n key
  offsetMonths Int // auto-scheduled relative to the occasion date: 12, 9, 6, 3, 1 (A2)
  sortOrder    Int       @default(0)

  @@index([templateId])
}

model Task {
  id             String     @id @default(cuid())
  occasionId     String
  occasion       Occasion   @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  ownerMemberId  String?
  owner          OccasionMember? @relation(fields: [ownerMemberId], references: [id])
  status         TaskStatus @default(todo)
  dueAt          DateTime?
  parentId       String?
  parent         Task?      @relation("TaskChildren", fields: [parentId], references: [id])
  children       Task[]     @relation("TaskChildren")
  templateTaskId String? // set when created from a template; unique per occasion (re-run diff, A2)
  createdById    String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  dependencies  TaskDependency[] @relation("TaskDeps")
  dependents    TaskDependency[] @relation("TaskDependents")
  checkItems    TaskCheckItem[]
  delegations   Delegation[]

  @@unique([occasionId, templateTaskId])
  @@index([occasionId])
  @@index([ownerMemberId])
}

model TaskDependency {
  id           String @id @default(cuid())
  taskId       String
  task         Task   @relation("TaskDeps", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnId  String
  dependsOn    Task   @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
}

model TaskCheckItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)

  @@index([taskId])
}

model Delegation {
  id           String          @id @default(cuid())
  taskId       String
  task         Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromMemberId String
  toMemberId   String
  state        DelegationState @default(offered)
  reason       String?
  createdAt    DateTime        @default(now())
  respondedAt  DateTime?

  @@index([taskId])
  @@index([toMemberId, state])
}

// Households: a lead responds for their party (A6). Children are never persons:
// only an attending count on the RSVP response — no child rows or fields anywhere.
model Household {
  id         String    @id @default(cuid())
  occasionId String
  occasion   Occasion  @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  name       String
  leadEmail  String? // captured when the household responds on the guest link (INF5)
  createdAt  DateTime  @default(now())

  guests      Guest[]
  invitations Invitation[]
  responses   RsvpResponse[]
  mealChoices MealChoice[]
  seatAssignments SeatAssignment[]
  privateRequests PrivateRequest[]
  publicRegistrations PublicRegistration[]
  checkIns CheckIn[]

  @@index([occasionId])
}

// Adult guests only (A6).
model Guest {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime     @default(now())

  attendances RsvpPersonAttendance[]

  @@index([householdId])
}

// Scoped, revocable guest links: >=128-bit random token, stored hashed (SEC2, SEC8).
model Invitation {
  id           String              @id @default(cuid())
  occasionId   String
  occasion     Occasion            @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  householdId  String
  household    Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tokenHash    String              @unique
  qrId         String              @unique @default(cuid()) // C-09: scoped QR id for printed invitations (the token itself stays hashed, SEC2)
  locale       String              @default("ro") // the guest link opens in the invitation language (L2)
  expiryMode   InvitationExpiryMode @default(never)
  expiresAt    DateTime?
  revokedAt    DateTime?
  createdAt    DateTime            @default(now())

  responses RsvpResponse[]
  votes     PollVote[]

  @@index([occasionId])
}

model RsvpQuestion {
  id         String           @id @default(cuid())
  occasionId String
  occasion   Occasion         @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  kind       RsvpQuestionKind
  promptKey  String // i18n key
  required   Boolean          @default(false)
  sortOrder  Int              @default(0)

  answers RsvpAnswer[]

  @@index([occasionId])
}

model RsvpResponse {
  id              String    @id @default(cuid())
  invitationId    String
  invitation      Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  adults          Int       @default(0)
  childrenCount   Int       @default(0) // count only — never child details (A6)
  lastSeenRevision Int      @default(0) // "changed since your last visit" marker (INF5)
  submittedAt     DateTime  @default(now())

  attendances RsvpPersonAttendance[]
  answers     RsvpAnswer[]

  @@index([invitationId])
  @@index([householdId])
}

// Each person's attendance is recorded per session (A6).
model RsvpPersonAttendance {
  id         String       @id @default(cuid())
  responseId String
  response   RsvpResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  guestId    String
  guest      Guest        @relation(fields: [guestId], references: [id], onDelete: Cascade)
  attending  Boolean

  @@unique([responseId, guestId])
}

model RsvpAnswer {
  id               String       @id @default(cuid())
  responseId       String
  response         RsvpResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  questionId       String
  question         RsvpQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  value            String
  childDataFlagged Boolean      @default(false) // free-text child-details warning (A6)

  @@index([responseId])
}

model DatePoll {
  id            String    @id @default(cuid())
  occasionId    String
  occasion      Occasion  @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  title         String?
  decidedDate   DateTime? // set when the host confirms (A7)
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())

  votes PollVote[]

  @@index([occasionId])
}

// Votes never reserve places (A7); capacity is enforced separately on Occasion (A8).
model PollVote {
  id           String     @id @default(cuid())
  pollId       String
  poll         DatePoll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  choice       PollChoice
  createdAt    DateTime   @default(now())

  @@unique([pollId, invitationId])
}

model ContributionNeed {
  id           String   @id @default(cuid())
  occasionId   String
  occasion     Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  title        String
  unitLabel    String?
  totalUnits   Int?
  claimedUnits Int      @default(0)
  createdById  String
  createdAt    DateTime @default(now())

  claims ContributionClaim[]

  @@index([occasionId])
}

// Atomic last-unit claims: conditional UPDATE on claimedUnits (A9).
model ContributionClaim {
  id         String     @id @default(cuid())
  needId     String
  need       ContributionNeed @relation(fields: [needId], references: [id], onDelete: Cascade)
  memberId   String?
  invitationId String?
  units      Int
  state      ClaimState @default(claimed)
  createdAt  DateTime   @default(now())
  releasedAt DateTime?

  @@index([needId])
}

// What-if previews and MCP proposals share one table (principle 3, MCP3):
// nothing is applied until explicit confirmation; confirm is idempotent (Q4).
model WhatIfPreview {
  id                  String       @id @default(cuid())
  occasionId          String?
  occasion            Occasion?    @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  subject             String
  delta               Json
  proposedByAccountId String?
  proposedByTokenId   String? // MCP token that proposed it (SEC15, MCP5)
  state               PreviewState @default(pending)
  idempotencyKey      String?      @unique
  createdAt           DateTime     @default(now())
  decidedAt           DateTime?

  @@index([occasionId])
}

model ReminderDigest {
  id         String   @id @default(cuid())
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  memberId   String
  digestDate DateTime // UTC day
  sentAt     DateTime @default(now())

  @@unique([occasionId, memberId, digestDate])
  @@index([digestDate])
}

// Postgres-backed job queue (Q7): leased with FOR UPDATE SKIP LOCKED (packages/jobs).
model Job {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  runAt       DateTime  @default(now())
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  lockedAt    DateTime?
  lockedBy    String?
  lastError   String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([runAt, completedAt])
}

// Q6 fair use: 500 emails/day/occasion enforced server-side via this log.
model EmailLog {
  id              String   @id @default(cuid())
  occasionId      String?
  toIdentifierHash String
  template        String
  sentAt          DateTime @default(now())

  @@index([occasionId, sentAt])
  @@index([sentAt])
}

// Hard-bounced addresses are never emailed again (INF2).
model EmailSuppression {
  id              String   @id @default(cuid())
  identifierHash  String   @unique
  reason          String
  createdAt       DateTime @default(now())
}

// Dev email transport writes here instead of calling a provider (R0-11).
model EmailOutbox {
  id        String   @id @default(cuid())
  to        String
  subject   String
  bodyText  String
  bodyHtml  String?
  template  String
  sentAt    DateTime @default(now())
}

// Single platform-level monetization switch (MON2), OFF by default.
model MonetizationSwitch {
  id              String    @id @default("main")
  state           String    @default("OFF") // OFF | ON
  history         Json      @default("[]")
  noticeStartedAt DateTime? // MON2/P28: 60-day public notice when switching ON
  noticeEndsAt    DateTime?
  updatedAt       DateTime  @updatedAt
}

// Server-side daily aggregates only; no visitor identifier anywhere (D4, INF11).
model StatsAggregate {
  id        String   @id @default(cuid())
  day       DateTime
  metric    String
  value     Float
  createdAt DateTime @default(now())

  @@unique([day, metric])
}

// ---------------------------------------------------------------------------
// Release B: budget, suppliers, deliveries, readiness, closeout (B1-B12)
// Money is integer minor units (bani) per currency; RON at launch (L3).
// ---------------------------------------------------------------------------

model BudgetCategory {
  id            String   @id @default(cuid())
  occasionId    String
  occasion      Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  name          String
  currency      String   @default("RON")
  // B1: five money states, stored and displayed separately, never merged.
  estimateBani  Int      @default(0)
  committedBani Int      @default(0)
  invoicedBani  Int      @default(0)
  paidBani      Int      @default(0)
  forecastBani  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expenses Expense[]

  @@index([occasionId])
}

model Expense {
  id             String         @id @default(cuid())
  occasionId     String
  occasion       Occasion       @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  categoryId     String
  category       BudgetCategory @relation(fields: [categoryId], references: [id])
  title          String
  amountBani     Int
  currency       String         @default("RON")
  receiptAssetId String?
  receipt        Asset?         @relation(fields: [receiptAssetId], references: [id])
  // B2: approval and payment are separate states.
  approvalState  String         @default("pending") // pending | approved | rejected
  paymentState   String         @default("unpaid") // unpaid | paid
  approvedById   String?
  paidAt         DateTime?
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([occasionId])
}

// R0-10: uploaded files (receipts, drawings, catalogues, quotes).
model Asset {
  id         String   @id @default(cuid())
  occasionId String?
  businessId String?
  uploaderId String
  kind       String // image | pdf | other
  storageKey String   @unique
  fileName   String
  mime       String
  sizeBytes  Int
  scanStatus String   @default("pending") // pending | clean | infected
  reEncoded  Boolean  @default(false)
  createdAt  DateTime @default(now())

  expenses Expense[]

  @@index([occasionId])
  @@index([businessId])
}

// B3: one balanced ledger - who paid, who benefits, who owes whom, per currency.
model LedgerEntry {
  id            String        @id @default(cuid())
  occasionId    String
  occasion      Occasion      @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  payerMemberId String
  amountBani    Int
  currency      String        @default("RON")
  note          String?
  createdAt     DateTime      @default(now())

  splits LedgerSplit[]

  @@index([occasionId])
}

model LedgerSplit {
  id        String      @id @default(cuid())
  entryId   String
  entry     LedgerEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  memberId  String
  shareBani Int

  @@unique([entryId, memberId])
}

model Supplier {
  id           String    @id @default(cuid())
  occasionId   String
  occasion     Occasion  @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  name         String
  contactEmail String?
  phone        String?
  notes        String?
  createdById  String
  createdAt    DateTime  @default(now())

  bookings Booking[]

  @@index([occasionId])
}

// B4: booking states enquired | quoted | booked | completed | cancelled.
model Booking {
  id           String    @id @default(cuid())
  supplierId   String
  supplier     Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  occasionId   String
  occasion     Occasion  @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  title        String
  state        String    @default("enquired")
  quoteAssetId String? // a PDF marked as a quote (P12)
  acceptedQuoteAssetId String? // P12/F6: the quote the planner accepted into the supplier record + budget
  createdById  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  briefings BriefingVersion[]
  snapshots OrderSnapshot[]
  deadlines PaymentDeadline[]

  @@index([occasionId])
}

// B4: versioned briefings, immutable; the supplier acknowledges via scoped link.
model BriefingVersion {
  id             String    @id @default(cuid())
  bookingId      String
  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  version        Int
  content        String
  createdById    String
  createdAt      DateTime  @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?

  @@unique([bookingId, version])
}

// B5: final-order snapshots are immutable; later changes are delta rows.
model OrderSnapshot {
  id          String    @id @default(cuid())
  bookingId   String
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  version     Int
  items       Json
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())

  deltas OrderDelta[]

  @@unique([bookingId, version])
}

model OrderDelta {
  id         String        @id @default(cuid())
  snapshotId String
  snapshot   OrderSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  change     Json
  source     String // rsvp_change | manual
  createdAt  DateTime      @default(now())
}

// B6: deliveries, hired items, returns. receivedQty changes ONLY via a
// Correction row - a DB trigger blocks direct overwrites (principle 4).
model Delivery {
  id          String   @id @default(cuid())
  occasionId  String
  occasion    Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  bookingId   String?
  title       String
  kind        String // delivery | hired_item | return
  expectedQty Int
  receivedQty Int      @default(0)
  unitLabel   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([occasionId])
}

// principle 4: facts (arrivals, payments, received stock) change only via an
// audited correction record that keeps before/after and actor - never overwritten.
model Correction {
  id         String   @id @default(cuid())
  targetType String
  targetId   String
  field      String
  before     Json
  after      Json
  actorId    String
  reason     String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

// B8: Hold | Proceed | Proceed with conditions, tied to evidence.
model ReadinessDecision {
  id         String   @id @default(cuid())
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  decision   String // hold | proceed | proceed_with_conditions
  evidence   Json // at least one evidence reference required
  actorId    String
  createdAt  DateTime @default(now())

  @@index([occasionId])
}

// B12: advances, instalments, final balances carry due dates; finance digest.
model PaymentDeadline {
  id         String    @id @default(cuid())
  bookingId  String
  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind       String // advance | instalment | final
  amountBani Int
  currency   String    @default("RON")
  dueAt      DateTime
  paidAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([dueAt])
}

// B10: closeout - unpaid balances, returns, deposits; lessons carried forward.
model Closeout {
  id             String    @id @default(cuid())
  occasionId     String    @unique
  occasion       Occasion  @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  unpaidBalances Json
  returns        Json
  deposits       Json
  lessons        String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

// ---------------------------------------------------------------------------
// Staff console (R0-13), deploys (R0-14), MCP call log (R0-15)
// ---------------------------------------------------------------------------

// S5: staff console session expires after 12 h or 30 min idle.
model StaffSession {
  id         String      @id @default(cuid())
  staffId    String
  staff      StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime    @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime    @default(now())

  @@index([staffId])
}

// DEP2-DEP6: every deploy audit-logged with hash, tag, actors, result, duration.
model Deploy {
  id           String    @id @default(cuid())
  tag          String
  commitHash   String
  requesterId  String
  approverId   String?
  result       String    @default("queued") // queued | running | done | failed | rolled_back
  ciStatus     String? // green | not_run | failed (DEP7)
  emergency    Boolean   @default(false)
  reason       String?
  startedAt    DateTime?
  finishedAt   DateTime?
  rolledBackAt DateTime?
  durationMs   Int?
  createdAt    DateTime  @default(now())
}

model McpCallLog {
  id      String    @id @default(cuid())
  tokenId String
  token   McpToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tool    String
  scope   String
  ok      Boolean   @default(true)
  error   String?
  at      DateTime  @default(now())

  @@index([tokenId])
  @@index([at])
}

// ---------------------------------------------------------------------------
// Release P: business module — directory, listings, moderation, discovery,
// drawings/space model, catalogues, enquiries, stats (P1-P33, V1-V11, F1-F6,
// BD1-BD7). MON5: while the monetization switch is OFF, FeaturedSlot rows are
// never created or rendered — the directory is organic only.
// ---------------------------------------------------------------------------

model Business {
  id                   String   @id @default(cuid())
  accountId            String   @unique // business accounts require an email (P29/P30)
  account              Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name                 String
  onrcRegistration     String? // "Verificat: înregistrare ONRC" badge (P4)
  insuranceValidUntil  DateTime? // "Verificat: asigurare văzută până la <data>" (P4)
  logoAssetId          String?
  accentColor          String? // P20 branding on guest pages of business occasions
  suspendedAt          DateTime? // W3 restriction, survives staff session end
  suspensionReason     String?
  nudge48h             Boolean  @default(true) // P32: the one 48h nudge has an off switch
  planLapsedAt         DateTime? // P23: on plan lapse only NEW business occasions/branding/library edits stop
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  members       BusinessMember[]
  listings      Listing[]
  occasions     Occasion[]
  libraryItems  BusinessLibraryItem[]
}

// P18: one owner, admins, staff; an admin cannot create or remove other admins.
model BusinessMember {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId  String
  role       String // owner | admin | staff
  createdAt  DateTime @default(now())

  @@unique([businessId, accountId])
  @@index([businessId])
}

// P2: the 21 fixed launch categories, ro name + en toggle.
model Category {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameRo    String
  nameEn    String
  sortKey   Int       @default(0)
  published Boolean   @default(true) // W4: publish/unpublish directory pages
  retiredAt DateTime? // W4: retired categories stop accepting new listings

  listings ListingCategory[]
}

// Geography: 41 counties + Bucharest as fixed picklist; locality second picklist (P2 defs).
model County {
  id     String  @id @default(cuid())
  code      String  @unique // e.g. "B", "CJ", "IF"
  nameRo    String
  nameEn    String
  published Boolean @default(true) // W4

  localities Locality[]
  listings   ListingCounty[]
}

model Locality {
  id       String  @id @default(cuid())
  countyId String
  county   County  @relation(fields: [countyId], references: [id], onDelete: Cascade)
  nameRo    String
  nameEn    String
  published Boolean @default(true) // W4

  @@unique([countyId, nameRo])
  listings ListingLocality[]
}

// P1/P29: up to 5 listings per business; unclaimed (discovery) listings carry
// the public contact route and the "not claimed yet" label, and cannot receive
// enquiries, quote requests, Featured or uploads until claimed (P29).
model Listing {
  id              String    @id @default(cuid())
  businessId      String? // null = unclaimed discovery listing
  business        Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  status          String    @default("draft") // draft | pending | live | suspended
  claimed         Boolean   @default(false) // P29/P30
  publicContactRoute String? // as the public source states it (unclaimed listings, P29)
  sourceUrl       String? // discovery source citation (BD2/BD4)
  hideStats       Boolean   @default(false) // P31: listing may hide its statistics
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  categories ListingCategory[]
  counties   ListingCounty[]
  localities ListingLocality[]
  revisions  ListingRevision[]
  drawings   Drawing[]
  catalogues FlowerCatalogue[]
  enquiries  Enquiry[]
  featured   FeaturedSlot[]

  @@index([status])
  @@index([businessId])
}

model ListingCategory {
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  @@id([listingId, categoryId])
}

model ListingCounty {
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  countyId  String
  county    County  @relation(fields: [countyId], references: [id])

  @@id([listingId, countyId])
}

model ListingLocality {
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  localityId String
  locality   Locality @relation(fields: [localityId], references: [id])

  @@id([listingId, localityId])
}

// P3: every listing revision (incl. drawings, catalogue items) is moderated by
// a staff member who is NOT a member of that business; the live version stays up
// while an edit is pending.
model ListingRevision {
  id          String    @id @default(cuid())
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  payload     Json
  state       String    @default("pending") // pending | approved | rejected | changes_requested
  moderatorId String?
  decidedAt   DateTime?
  reason      String?
  createdAt   DateTime  @default(now())

  @@index([listingId, state])
}

// V1-V11: venue drawings, calibrated (V7), versioned into plan space models (V4).
model Drawing {
  id             String    @id @default(cuid())
  listingId      String
  listing        Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  assetId        String
  spaceName      String
  realWidthM     Float? // stated real dimensions (V1)
  realHeightM    Float?
  calibrationP1  Json? // two-point calibration (V7)
  calibrationP2  Json?
  pixelsPerMeter Float? // derived scale; null = uncalibrated, unusable for space models (V7)
  revisionId     String? // moderated with the listing (V3)
  version        Int       @default(1)
  createdAt      DateTime  @default(now())

  tables      TableInventory[]
  fixtures    Fixture[]
  pois        PointOfInterest[]
  parking     ParkingFacts?
  spaceModels SpaceModelVersion[]

  @@index([listingId])
}

model TableInventory {
  id          String   @id @default(cuid())
  drawingId   String
  drawing     Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  tableType   String
  widthM      Float?
  heightM     Float?
  count       Int

  @@index([drawingId])
}

// V5: planner-defined custom tables, marked custom, never venue-supplied.
model CustomTable {
  id             String   @id @default(cuid())
  spaceModelId   String
  spaceModel     SpaceModelVersion @relation(fields: [spaceModelId], references: [id], onDelete: Cascade)
  name           String
  widthM         Float?
  heightM        Float?

  @@index([spaceModelId])
}

// V8: named fixtures with real dimensions (dance floor, candy bar, photo cabin, scenă…).
model Fixture {
  id        String  @id @default(cuid())
  drawingId String
  drawing   Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  kind      String // dance_floor | candy_bar | photo_cabin | stage | other
  widthM    Float?
  heightM   Float?

  @@index([drawingId])
}

// V8/V9: points of interest (toilets, garderobă, bar, intrări/ieșiri, colț foto, scenă).
model PointOfInterest {
  id        String  @id @default(cuid())
  drawingId String
  drawing   Drawing @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  kind      String // toilet | cloakroom | bar | entrance | exit | photo_corner | stage
  label     String?

  @@index([drawingId])
}

// V10/V11: parking facts, each known or unknown — never guessed, never blank.
model ParkingFacts {
  id                  String   @id @default(cuid())
  drawingId           String   @unique
  drawing             Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  onSite              Boolean? // null = unknown
  spaceCount          Int? // null = unknown
  onStreet            Boolean?
  paid                Boolean?
  accessibleSpaces    Boolean?
  walkingDistanceM    Float?
  drawingSpaceCount   Int? // count drawn on the drawing; mismatch => unknown until confirmed (V11)
  createdAt           DateTime @default(now())
}

// V4: the occasion's space model, pinned to a drawing version + effective date;
// later drawing updates arrive as a What-if proposal, never a silent overwrite.
model SpaceModelVersion {
  id           String    @id @default(cuid())
  occasionId   String
  occasion     Occasion  @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  drawingId    String
  drawing      Drawing   @relation(fields: [drawingId], references: [id])
  version      Int
  effectiveAt  DateTime  @default(now())
  acceptedById String?

  customTables CustomTable[]

  @@index([occasionId])
}

// F1/F2: flower catalogues, moderated with the listing, reusable across occasions.
model FlowerCatalogue {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name      String
  revisionId String?
  createdAt DateTime @default(now())

  items CatalogueItem[]

  @@index([listingId])
}

model CatalogueItem {
  id           String         @id @default(cuid())
  catalogueId  String
  catalogue    FlowerCatalogue @relation(fields: [catalogueId], references: [id], onDelete: Cascade)
  variety      String
  imageAssetId String?
  seasonality  String?
  pricePerStemBani Int? // indicative price per stem/bunch (F1) — indicative, never a quote (F3)
  colours      String[]

  @@index([catalogueId])
}

// P8-P11/P33/F5: enquiry threads planner <-> business. State: sent/awaiting/answered/closed.
model Enquiry {
  id            String   @id @default(cuid())
  listingId     String
  listing       Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  occasionId    String? // P10: the thread sits in the plan
  supplierId    String? // linked supplier record (P10)
  plannerAccountId String
  state         String   @default("sent") // sent | awaiting | answered | closed
  kind          String   @default("enquiry") // enquiry | quote_request (F5)
  payload       Json // P8 fields: occasion kind, date, ~guests, county/locality, budget band, message; F5: arrangement + date + guests + message only
  shareEmail    Boolean  @default(false) // P9: planner email shared only if ticked
  sentAt        DateTime @default(now())
  answeredAt    DateTime?
  closedAt      DateTime?
  resendCount   Int      @default(0) // P33: re-send once after 7 days
  lastResendAt  DateTime?
  nudged48h     Boolean  @default(false) // P32: at most one 48h nudge

  messages EnquiryMessage[]

  @@index([listingId])
  @@index([plannerAccountId])
  @@index([occasionId])
}

model EnquiryMessage {
  id        String   @id @default(cuid())
  enquiryId String
  enquiry   Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  fromBusiness Boolean @default(false)
  body      String
  quoteAssetId String? // P12/F6: a PDF marked as a quote
  arrangementVersionId String? // F6 link
  createdAt DateTime @default(now())

  @@index([enquiryId])
}

// BD1-BD7: discovery sources, runs and unclaimed drafts (never public until approved).
model DiscoverySource {
  id          String   @id @default(cuid())
  name        String   @unique
  kind        String // onrc | website | social | licensed_dataset
  enabled     Boolean  @default(true) // BD7 kill switch per source
  rateLimitPerHour Int @default(60)
  config      Json?
  createdAt   DateTime @default(now())

  runs   DiscoveryRun[]
  drafts DiscoveryDraft[]
}

model DiscoveryRun {
  id         String          @id @default(cuid())
  sourceId   String
  source     DiscoverySource @relation(fields: [sourceId], references: [id])
  startedAt  DateTime        @default(now())
  finishedAt DateTime?
  itemsFound Int             @default(0)
  draftsCreated Int          @default(0)
  duplicatesSkipped Int      @default(0)

  drafts DiscoveryDraft[]

  @@index([sourceId])
}

// BD2/BD3: unclaimed draft listing; dedup by name/address/public identifiers,
// suspected duplicates queued for humans, never auto-merged.
model DiscoveryDraft {
  id            String   @id @default(cuid())
  sourceId      String
  source        DiscoverySource @relation(fields: [sourceId], references: [id])
  name          String
  categoryGuess String?
  countyCode    String?
  locality      String?
  publicContactRoute String?
  sourceUrl     String
  collectedAt   DateTime  @default(now())
  state         String    @default("pending") // pending | approved | rejected | duplicate_queued
  listingId     String? // set when approved -> live unclaimed listing
  runId         String?
  run           DiscoveryRun? @relation(fields: [runId], references: [id])

  @@index([state])
}

// BD5: a single claim invitation per approved unclaimed listing, emailed only to
// the publicly listed address; none if no public email.
model ClaimInvitation {
  id          String   @id @default(cuid())
  listingId   String   @unique
  sentAt      DateTime @default(now())
  codeHash    String? // P30: code emailed to the published contact address
}

// BD6: removal/objection requests honoured within 30 days, recorded 3 years (INF6).
model ObjectionRecord {
  id          String   @id @default(cuid())
  listingId   String?
  contactHash String
  kind        String // removal | objection | correction
  detail      String
  receivedAt  DateTime @default(now())
  handledAt   DateTime?
  handledBy   String?

  @@index([handledAt])
}

// P31/INF11: daily aggregates computed by the nightly worker; no visitor identifiers.
model ListingStats {
  id              String   @id @default(cuid())
  listingId       String   @unique
  enquiriesSent   Int      @default(0)
  enquiriesAnswered Int    @default(0)
  medianReplyHours Float?
  computedAt      DateTime @default(now())
}

// P13-P16/MON5: dormant while the switch is OFF — never created or rendered then.
model FeaturedSlot {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  categoryId String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([categoryId, active])
}

// P24-P26/PAY: dormant until MON ON; features switch only from a verified webhook.
model Subscription {
  id                   String    @id @default(cuid())
  businessId           String
  kind                 String // business_plan | featured
  state                String    @default("active") // active | past_due | lapsed | canceled
  priceBani            Int // PAY4: excl. TVA
  currency             String    @default("RON")
  periodEnd            DateTime?
  graceUntil           DateTime? // P25: 14 days of grace after a failed renewal
  cancelAtPeriodEnd    Boolean   @default(false) // P25: cancellation takes effect at period end
  processorRef         String? // Stripe/etc reference, from webhook only (P24)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime  @default(now())

  @@index([businessId])
}

model Invoice {
  id             String    @id @default(cuid())
  subscriptionId String?
  businessId     String
  number         String?   @unique
  amountBani     Int // PAY4: excl. TVA
  tvaBani        Int       @default(0) // PAY4: TVA shown separately
  currency       String    @default("RON")
  status         String    @default("issued") // issued | paid | void
  fiscalRef      String? // PAY3: RO e-Factura reference via SmartBill/Oblio webhook (SANDBOX-* in test mode)
  pdfAssetId     String?
  issuedAt       DateTime?
  createdAt      DateTime  @default(now())
}

// --- v0.4.0: finish Release P (P-08/P-12/P-13/P-14) ---

// P19: shared libraries of templates, checklists and supplier contacts, shareable
// to the whole business team.
model BusinessLibraryItem {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind        String // template | checklist | supplier_contact
  title       String
  payload     Json
  createdById String
  createdAt   DateTime @default(now())

  @@index([businessId, kind])
}

// P21/D4: catalogue-item and drawing usage as DAILY TOTALS — no visitor identifier.
model AssetUsageDaily {
  id        String   @id @default(cuid())
  day       DateTime // UTC day
  assetKind String // drawing | catalogue_item
  assetId   String
  listingId String
  uses      Int      @default(0)

  @@unique([day, assetKind, assetId])
  @@index([listingId])
}

// P15: last-30-days directory searches per category x county, daily aggregates only.
model DirectorySearchDaily {
  id         String   @id @default(cuid())
  day        DateTime
  categoryId String
  countyId   String
  searches   Int      @default(0)

  @@unique([day, categoryId, countyId])
}

// MON4: billing acceptance in test mode must be recorded before the switch can go ON.
model BillingAcceptance {
  id               String    @id @default("main")
  testModePassedAt DateTime?
  verifiedBy       String?
  notes            String?
  updatedAt        DateTime  @updatedAt
}

// W8: compliance access to retained data needs THREE people (19.12).
model ComplianceAccessRequest {
  id        String   @id @default(cuid())
  requesterId String
  purpose   String
  approvals String[] // accountIds of approvers; needs 3 distinct
  state     String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
}

// W7: platform notices go to businesses only — never to planner-entered contacts (19.11).
model PlatformNotice {
  id         String   @id @default(cuid())
  subject    String
  body       String
  sentById   String
  sentAt     DateTime?
  recipientCount Int   @default(0)
  createdAt  DateTime @default(now())
}

// LAU8 (DSA notice-and-action): reports reuse the W3 restriction flow + SEC10 audit.
model ContentReport {
  id          String    @id @default(cuid())
  reporterContactHash String
  listingId   String?
  kind        String // illegal_content | unlawful_listing | other
  detail      String
  state       String    @default("open") // open | actioned | dismissed
  decidedBy   String?
  decidedAt   DateTime?
  reason      String?
  receivedAt  DateTime  @default(now())
}

// --- v0.5.0: Release C (design and run a celebration) ---

// C-01/C-08: seating plan on the occasion's space model. Assignments are a draft
// until published; unpublished seating is NEVER visible to guests (C-08).
model SeatingPlan {
  id          String   @id @default(cuid())
  occasionId  String
  occasion    Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  version     Int      @default(1)
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdById String
  createdAt   DateTime @default(now())

  assignments SeatAssignment[]

  @@index([occasionId])
}

model SeatAssignment {
  id          String      @id @default(cuid())
  planId      String
  plan        SeatingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  householdId String
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  tableRef    String // space-model table id or "custom:<id>"
  seat        String? // seat label if assigned

  @@unique([planId, householdId])
}

// C-02: fit check at every meal stage (incl. between courses) against stated dims.
model MealStage {
  id         String   @id @default(cuid())
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  label      String // e.g. "starter", "main", "between courses"
  guestCount Int
  result     Json? // { checked, excludedUnknown } from V6 fit check
  checkedAt  DateTime?
  createdAt  DateTime @default(now())
}

// C-03: entertainment programme + versioned cue list.
model ProgrammeItem {
  id          String   @id @default(cuid())
  occasionId  String
  occasion    Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  title       String
  startsAt    DateTime?
  durationMin Int?
  version     Int      @default(1) // cue list versioned per item
  createdAt   DateTime @default(now())

  cues Cue[]
}

model Cue {
  id      String        @id @default(cuid())
  itemId  String
  item    ProgrammeItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  atLabel String // "T-10min" etc.
  action  String
  note    String?
}

// C-04: invitation/stationery design versions; proof step before send; print-ready PDF.
model InvitationDesign {
  id              String   @id @default(cuid())
  occasionId      String
  occasion        Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  version         Int      @default(1)
  content         Json
  pdfAssetId      String?
  proofApprovedAt DateTime? // proof step before send (C-04)
  createdById     String
  createdAt       DateTime @default(now())
}

// C-05: menus, per-guest meal choices, quantities into order snapshots.
model Menu {
  id         String   @id @default(cuid())
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  name       String
  items      MenuItem[]
}

model MenuItem {
  id        String   @id @default(cuid())
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name      String
  dietTags  String[] // vegetarian, vegan, child, allergen...
  choices   MealChoice[]
}

model MealChoice {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  itemId      String
  item        MenuItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([householdId, itemId])
}

// C-06: public event page registration + waitlist (atomic promotion like A8) +
// conditional questions. SEC11 bot protection on the public POST route.
model PublicRegistration {
  id         String    @id @default(cuid())
  occasionId String
  occasion   Occasion  @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  householdId String?
  household  Household? @relation(fields: [householdId], references: [id])
  name       String
  contactHash String // hashed contact; never stored raw
  answers    Json // conditional question answers
  state      String    @default("registered") // registered | waitlist
  createdAt  DateTime  @default(now())

  @@index([occasionId])
}

// C-07: private dietary/access requests — visible only with the privateRequests grant (D2).
model PrivateRequest {
  id          String    @id @default(cuid())
  occasionId  String
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id])
  kind        String // diet | access
  detail      String
  createdAt   DateTime  @default(now())

  @@index([occasionId])
}

// C-11: gift estimator — private per-planner, labelled cultural guide, no sharing.
model GiftEstimate {
  id          String   @id @default(cuid())
  accountId   String
  inputs      Json // relationship, distance, venue type
  rangeMinBani Int
  rangeMaxBani Int
  createdAt   DateTime @default(now())
}

// C-13: flower arrangement design versions; linked to the accepted quote (F6).
model ArrangementDesign {
  id          String   @id @default(cuid())
  occasionId  String
  occasion    Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  accountId   String
  baseForm    String
  items       Json // [{ catalogueItemId, stems }]
  indicativeCostBani Int @default(0) // F3: indicative, never a quote
  version     Int      @default(1)
  quoteEnquiryId String? // F5/F6: the quote request sent from this design
  acceptedQuoteAssetId String?
  createdAt   DateTime @default(now())
}

// --- v0.6.0: Release D (solo or group holiday) ---

// D-01: itinerary legs — stored in UTC (INF8), displayed in Europe/Bucharest and the
// trip zone. Booking imports arrive as What-if previews and apply only on confirm.
model ItineraryLeg {
  id          String   @id @default(cuid())
  occasionId  String
  occasion    Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  title       String
  kind        String // flight | stay | transport | activity | other
  startsAtUtc DateTime
  endsAtUtc   DateTime?
  zone        String   @default("Europe/Bucharest") // IANA trip zone for display
  details     Json?
  createdAt   DateTime @default(now())

  @@index([occasionId])
}

// D-02: subgroups with scoped views (grants respected, D2).
model Subgroup {
  id         String   @id @default(cuid())
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  name       String
  members    SubgroupMember[]
  activities Activity[]
  packing    PackingItem[]

  @@index([occasionId])
}

model SubgroupMember {
  id          String   @id @default(cuid())
  subgroupId  String
  subgroup    Subgroup @relation(fields: [subgroupId], references: [id], onDelete: Cascade)
  householdId String

  @@unique([subgroupId, householdId])
}

// D-02: optional activities, optionally subgroup-scoped.
model Activity {
  id          String    @id @default(cuid())
  occasionId  String
  occasion    Occasion  @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  subgroupId  String?
  subgroup    Subgroup? @relation(fields: [subgroupId], references: [id])
  title       String
  startsAtUtc DateTime
  zone        String    @default("Europe/Bucharest")
  optional    Boolean   @default(true)
}

// D-03: packing lists (checklist reuse).
model PackingItem {
  id          String    @id @default(cuid())
  occasionId  String
  occasion    Occasion  @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  subgroupId  String?
  subgroup    Subgroup? @relation(fields: [subgroupId], references: [id])
  label       String
  packed      Boolean   @default(false)
  packedAt    DateTime?
}

// D-04: transport legs.
model TransportLeg {
  id          String   @id @default(cuid())
  occasionId  String
  occasion    Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  label       String
  fromPlace   String
  toPlace     String
  departsAtUtc DateTime
  seats       Int      @default(0)
  zone        String   @default("Europe/Bucharest")
}

// D-04: room allocation — assigned atomically like capacity (A8): conditional UPDATE
// on Room.occupants, rowCount decides success.
model Room {
  id         String   @id @default(cuid())
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  name       String
  capacity   Int
  occupants  Int      @default(0)
  assignments RoomAssignment[]

  @@index([occasionId])
}

model RoomAssignment {
  id          String @id @default(cuid())
  roomId      String
  room        Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  householdId String

  @@unique([roomId, householdId])
}

// E-02: QR check-in arrivals. Each arrival is marked via an audited Correction row
// (principle 4); the scan itself is idempotent per household (Q4).
model CheckIn {
  id           String    @id @default(cuid())
  occasionId   String
  occasion     Occasion  @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  qrId         String // scoped invitation qrId that was scanned (C-09)
  checkedInAt  DateTime  @default(now())
  actorId      String? // account that scanned / reconciled
  via          String    @default("qr") // qr | offline_reconciled
  correctionId String?   @unique // Correction row recording before/after (principle 4)

  @@unique([occasionId, householdId])
  @@index([occasionId])
}

// E-03: limited offline capture — arrivals and own checklist ticks only. Queued with a
// client idempotency key (Q4), reconciled once on reconnect; conflicts are surfaced in
// `result`, never silently merged.
model OfflineSyncItem {
  id           String   @id @default(cuid())
  occasionId   String
  occasion     Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  clientKey    String // idempotency key from the offline device (Q4)
  kind         String // arrival | checklist_tick
  payload      Json
  actorId      String
  createdAtUtc DateTime @default(now())
  state        String   @default("pending") // pending | applied | conflict
  result       Json?

  @@unique([occasionId, clientKey])
  @@index([occasionId, state])
}

// E-04: optional sustainability goals tracked against measured quantities.
// measured = null means unknown — unknown stays unknown (principle 5).
model SustainabilityGoal {
  id         String   @id @default(cuid())
  occasionId String
  occasion   Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  metric     String // e.g. food_waste_kg | transport_km | single_use_items
  unit       String
  target     Float? // optional goal; null = measure only
  measured   Float? // null = unknown (principle 5)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([occasionId, metric])
  @@index([occasionId])
}

